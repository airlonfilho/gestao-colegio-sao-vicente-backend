generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  admin
  professor
}

enum StatusAluno {
  ATIVO
  INATIVO
}

enum StatusMensalidade {
  PAGO
  PENDENTE
  ATRASADO
}

enum FormaPagamento {
  PIX
  BOLETO
  CARTAO
  DINHEIRO
  FOLHA_PAGAMENTO
}

enum StatusMensagem {
  PENDENTE
  ENVIADO
  ERRO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil
  /// Foto de perfil em data URL base64 (image/jpeg|png|webp).
  foto      String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  notasLancadas Nota[]
  turmasLecionadas TurmaDisciplinaProfessor[]

  @@map("usuarios")
}

model Funcionario {
  id           Int       @id @default(autoincrement())
  nome         String
  cargo        String
  cpf          String    @unique
  dataAdmissao DateTime? @map("data_admissao")

  despesas  Despesa[]
  registros RegistroFuncionario[]

  @@map("funcionarios")
}

model Responsavel {
  id        Int     @id @default(autoincrement())
  nome      String
  cpf       String  @unique
  telefone  String
  email     String?
  endereco  String?

  alunos Aluno[]

  @@map("responsaveis")
}

model Turma {
  id               Int     @id @default(autoincrement())
  nome             String
  nivelEnsino      String  @map("nivel_ensino")
  sala             String?
  anoLetivo        Int     @map("ano_letivo")
  valorMensalidade Decimal @map("valor_mensalidade") @db.Decimal(10, 2)

  alunos        Aluno[]
  professores   TurmaDisciplinaProfessor[]
  disciplinas   TurmaDisciplina[]

  @@map("turmas")
}

model Disciplina {
  id   Int    @id @default(autoincrement())
  nome String
  /// Nome sem acentos/maiúsculas, para impedir duplicatas ("Matemática" = "MATEMATICA").
  nomeNormalizado String @unique @map("nome_normalizado")

  notas       Nota[]
  professores TurmaDisciplinaProfessor[]
  turmas      TurmaDisciplina[]

  @@map("disciplinas")
}

/// Currículo da turma: quais disciplinas a turma tem (independe de haver professor vinculado).
model TurmaDisciplina {
  turmaId      Int @map("turma_id")
  disciplinaId Int @map("disciplina_id")

  turma      Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])

  @@id([turmaId, disciplinaId])
  @@index([disciplinaId])
  @@map("turma_disciplinas")
}

model TurmaDisciplinaProfessor {
  id           Int @id @default(autoincrement())
  turmaId      Int @map("turma_id")
  disciplinaId Int @map("disciplina_id")
  usuarioId    Int @map("usuario_id")

  turma      Turma      @relation(fields: [turmaId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  professor  Usuario    @relation(fields: [usuarioId], references: [id])

  @@unique([turmaId, disciplinaId])
  @@index([usuarioId])
  @@map("turma_disciplina_professor")
}

model Aluno {
  id             Int         @id @default(autoincrement())
  nome           String
  dataNascimento DateTime?   @map("data_nascimento")
  turmaId        Int         @map("turma_id")
  responsavelId  Int         @map("responsavel_id")
  status         StatusAluno @default(ATIVO)
  matriculaEm    DateTime    @default(now()) @map("matricula_em")
  /// Foto em data URL base64 (image/jpeg|png|webp).
  foto           String?

  turma       Turma       @relation(fields: [turmaId], references: [id])
  responsavel Responsavel @relation(fields: [responsavelId], references: [id])

  notas              Nota[]
  mensalidades       Mensalidade[]
  mensagensWhatsapp  MensagemWhatsapp[]
  observacoesBoletim ObservacaoBoletim[]

  @@index([turmaId])
  @@index([responsavelId])
  @@index([nome])
  @@index([status])
  @@map("alunos")
}

model Nota {
  id           Int     @id @default(autoincrement())
  alunoId      Int     @map("aluno_id")
  disciplinaId Int     @map("disciplina_id")
  bimestre     Int
  anoLetivo    Int     @map("ano_letivo")
  nota         Decimal @db.Decimal(4, 2)
  lancadoPor   Int     @map("lancado_por")

  aluno      Aluno      @relation(fields: [alunoId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  professor  Usuario    @relation(fields: [lancadoPor], references: [id])

  @@unique([alunoId, disciplinaId, bimestre, anoLetivo])
  @@index([disciplinaId])
  @@index([lancadoPor])
  @@map("notas")
}

model Mensalidade {
  id             Int               @id @default(autoincrement())
  alunoId        Int               @map("aluno_id")
  mesReferencia  String            @map("mes_referencia")
  valor          Decimal           @db.Decimal(10, 2)
  vencimento     DateTime
  status         StatusMensalidade @default(PENDENTE)
  dataPagamento  DateTime?         @map("data_pagamento")
  formaPagamento FormaPagamento?   @map("forma_pagamento")

  aluno Aluno @relation(fields: [alunoId], references: [id])

  @@unique([alunoId, mesReferencia])
  @@index([status, vencimento])
  @@index([mesReferencia])
  @@map("mensalidades")
}

model Despesa {
  id             Int            @id @default(autoincrement())
  titulo         String
  categoria      String
  funcionarioId  Int            @map("funcionario_id")
  formaPagamento FormaPagamento @map("forma_pagamento")
  valor          Decimal        @db.Decimal(10, 2)
  data           DateTime

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@index([funcionarioId])
  @@map("despesas")
}

model RegistroFuncionario {
  id            Int      @id @default(autoincrement())
  funcionarioId Int      @map("funcionario_id")
  tipo          String
  descricao     String?
  valor         Decimal  @db.Decimal(10, 2)
  data          DateTime

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@index([funcionarioId])
  @@map("registros_funcionario")
}

model MensagemWhatsapp {
  id        Int            @id @default(autoincrement())
  alunoId   Int            @map("aluno_id")
  tipo      String
  mensagem  String
  status    StatusMensagem @default(PENDENTE)
  enviadoEm DateTime?      @map("enviado_em")
  criadoEm  DateTime       @default(now()) @map("criado_em")

  aluno Aluno @relation(fields: [alunoId], references: [id])

  @@index([alunoId])
  @@map("mensagens_whatsapp")
}

/// Observações do boletim, por aluno, ano letivo e período ("anual", "1" ou "2" = semestre).
model ObservacaoBoletim {
  id           Int      @id @default(autoincrement())
  alunoId      Int      @map("aluno_id")
  anoLetivo    Int      @map("ano_letivo")
  periodo      String
  texto        String
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, anoLetivo, periodo])
  @@map("observacoes_boletim")
}
