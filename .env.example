PORT=3333
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio
# WhatsApp (Evolution API, container "evolution" do docker-compose).
# Use a MESMA chave aqui e no compose (o compose lê este .env). Gere uma chave longa: openssl rand -hex 32
EVOLUTION_API_KEY=troque-por-uma-chave-grande-e-aleatoria
# Rodando a API fora do Docker: http://localhost:8080. Dentro do compose o valor já vem definido.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=colegio-sao-vicente
